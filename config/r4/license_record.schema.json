{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wgt-v11.invalid/schema/r4/license_record.schema.json",
  "title": "WGT-V11 R4 license and source record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "protocol_stage",
    "status",
    "distribution_allowed",
    "project_license",
    "dependency_lock",
    "primary_sources",
    "locked_packages",
    "release_blockers"
  ],
  "properties": {
    "record_id": {"const": "WGT-V11-R4-LICENSE-RECORD-01"},
    "protocol_stage": {"const": "R4"},
    "status": {"const": "RECORDED_MIT_DISTRIBUTION_ALLOWED"},
    "distribution_allowed": {"const": true},
    "project_license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "spdx_identifier", "sha256"],
      "properties": {
        "path": {"const": "LICENSE"},
        "spdx_identifier": {"const": "MIT"},
        "sha256": {"pattern": "^[0-9a-f]{64}$"}
      }
    },
    "dependency_lock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "target"],
      "properties": {
        "path": {"const": "requirements-r4-benchmark.lock"},
        "sha256": {"pattern": "^[0-9a-f]{64}$"},
        "target": {"const": "CPython 3.12 Windows AMD64"}
      }
    },
    "primary_sources": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "component",
          "use",
          "source",
          "version_or_commit",
          "license",
          "vendored"
        ],
        "properties": {
          "component": {"type": "string", "minLength": 1},
          "use": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "version_or_commit": {"type": "string", "minLength": 1},
          "sha256": {"pattern": "^[0-9a-f]{64}$"},
          "license": {"type": "string", "minLength": 1},
          "vendored": {"type": "boolean"},
          "distribution_note": {"type": "string"}
        }
      }
    },
    "locked_packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "license"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "license": {"type": "string", "minLength": 1}
        }
      }
    },
    "release_blockers": {
      "type": "array",
      "maxItems": 0,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
