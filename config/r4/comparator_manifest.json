  "shared_contract": {
    "objective_constraint_evaluator": "EventProblemAdapter.evaluate through the project SharedEvaluator only",
    "constraint_convention": "c_le_0_feasible",
    "repair_policy": "Project midpoint repair for DE boundary violations; bounded SBX and polynomial mutation for NSGA-II; every produced candidate is evaluated only after bounds validation",
    "budget_unit": "joint_candidate_evaluation_CFE",
    "atomic_step_accounting": "Every evaluator entry charges one CFE and the adapter-declared atomic model steps; initialization, warm-start re-evaluation, duplicate points, cache hits, and numerical failures are charged",
    "information_boundary": "Each event uses one immutable InformationSnapshot; prohibited future, hidden, participant, and cross-method result fields remain unavailable",
    "paired_seed_policy": "The future R5 run contract must supply paired problem/environment seeds across methods and an independent method RNG seed; R4 classes accept explicit seeds and never choose seeds from results",
    "failure_policy": "Repair failure is typed before evaluator entry; numerical failure is charged, typed, marked infeasible, and excluded; no-feasible, safety rejection, timeout, and budget exhaustion remain typed",
    "archive_policy": "Shared normalized constraint-domination and feasible nondominated archive with a common capacity",
    "selector_policy": "Static and CDF report the feasible nondominated archive; WGT-RR uses equal-weight augmented Tchebycheff on f/(1+f), rho=1e-6, then candidate_id tie-break",
    "resource_policy_stage": "R5"
  },
